{
  "contexts": [
    {
      "name": "AuthContext",
      "states": [
        "user",
        "authLoading"
      ],
      "description": "사용자 인증 및 세션 관리. Supabase 세션 체크 및 로그인 상태 추적",
      "suggested_interface": {
        "user": "any | null",
        "authLoading": "boolean"
      }
    },
    {
      "name": "NetworkContext",
      "states": [
        "isOnline",
        "networkError"
      ],
      "description": "네트워크 연결 상태 및 에러 메시지. API 오류 처리 및 재시도 로직",
      "suggested_interface": {
        "isOnline": "boolean",
        "networkError": "string | null"
      }
    },
    {
      "name": "NavigationContext",
      "states": [
        "activeTab",
        "roomSubTab",
        "showSettingsModal",
        "isSettingsGameActive",
        "isSwipeBackBlocked"
      ],
      "description": "앱 레이아웃 및 모달 네비게이션. 탭 전환, 설정 화면, 스와이프 제스처 제어",
      "suggested_interface": {
        "activeTab": "'schedule' | 'addons'",
        "roomSubTab": "'schedule' | 'menu' | 'baemin' | 'dutch'",
        "showSettingsModal": "boolean",
        "isSettingsGameActive": "boolean",
        "isSwipeBackBlocked": "boolean"
      }
    },
    {
      "name": "RoomContext",
      "states": [
        "currentRoom",
        "participants",
        "currentParticipant",
        "roomList",
        "roomMessages",
        "newMessageText",
        "roomOverlay",
        "timeLeft"
      ],
      "description": "방 정보, 참여자, 메시지, 타이머 관리. 24시간 카운트다운 및 실시간 채팅 동기화",
      "suggested_interface": {
        "currentRoom": "Room | null",
        "participants": "Participant[]",
        "currentParticipant": "Participant | null",
        "roomList": "Room[]",
        "roomMessages": "Message[]",
        "newMessageText": "string",
        "roomOverlay": "'schedule' | 'dutch' | null",
        "timeLeft": "string"
      }
    },
    {
      "name": "ProfileContext",
      "states": [
        "globalProfile",
        "myFollows",
        "selectedProfile",
        "selectedProfileId",
        "showProfileModal"
      ],
      "description": "현재 사용자 프로필 및 팔로우 관계 관리. 다른 사용자 프로필 조회 및 모달 표시",
      "suggested_interface": {
        "globalProfile": "Profile | null",
        "myFollows": "Follow[]",
        "selectedProfile": "Profile | null",
        "selectedProfileId": "string | null",
        "showProfileModal": "boolean"
      }
    },
    {
      "name": "FriendSearchContext",
      "states": [
        "searchFriendQuery",
        "searchFriendResults",
        "recommendedFriends",
        "isSearchingFriends",
        "lastMessageSender"
      ],
      "description": "친구 검색 및 추천 기능. 검색 쿼리, 결과, 로딩 상태 관리",
      "suggested_interface": {
        "searchFriendQuery": "string",
        "searchFriendResults": "Profile[]",
        "recommendedFriends": "Profile[]",
        "isSearchingFriends": "boolean",
        "lastMessageSender": "string | null"
      }
    },
    {
      "name": "RoomCreationContext",
      "states": [
        "showCreateModal",
        "newRoomTitle",
        "newRoomDate",
        "createRoomSelectedFriends",
        "joinRoomCode"
      ],
      "description": "새 방 생성 및 코드 기반 참여. 방 이름, 초대 친구, 초대 코드 입력",
      "suggested_interface": {
        "showCreateModal": "boolean",
        "newRoomTitle": "string",
        "newRoomDate": "string",
        "createRoomSelectedFriends": "string[]",
        "joinRoomCode": "string"
      }
    },
    {
      "name": "RoomEditingContext",
      "states": [
        "showRoomInfoModal",
        "isEditingRoomTitle",
        "editingRoomTitle",
        "isEditingRoomLocation",
        "editingRoomLocationName",
        "editingRoomLatitude",
        "editingRoomLongitude"
      ],
      "description": "방 정보 수정 UI 제어. 방 이름 및 약속 장소 편집",
      "suggested_interface": {
        "showRoomInfoModal": "boolean",
        "isEditingRoomTitle": "boolean",
        "editingRoomTitle": "string",
        "isEditingRoomLocation": "boolean",
        "editingRoomLocationName": "string",
        "editingRoomLatitude": "number",
        "editingRoomLongitude": "number"
      }
    },
    {
      "name": "NotificationContext",
      "states": [
        "appNotifications",
        "showNotifications",
        "showNotificationsRedDot",
        "showGlobalDutchPay"
      ],
      "description": "정산 알림 및 N빵 대장 관리. 미지급 정산 정보 표시 및 빨간 점 표시",
      "suggested_interface": {
        "appNotifications": "AppNotification[]",
        "showNotifications": "boolean",
        "showNotificationsRedDot": "boolean",
        "showGlobalDutchPay": "boolean"
      }
    },
    {
      "name": "AIRecommendationContext",
      "states": [
        "showAIRecommendModal",
        "aiRecommendations"
      ],
      "description": "AI 기반 일정 추천 기능. 추천 모달 표시 및 추천 결과 저장",
      "suggested_interface": {
        "showAIRecommendModal": "boolean",
        "aiRecommendations": "AIRecommendation[]"
      }
    },
    {
      "name": "LocationContext",
      "states": [
        "locationSearchResults",
        "showLocationResults",
        "showLocationMapModal",
        "mapRegion"
      ],
      "description": "지도 및 위치 검색. 약속 장소 선택 및 지도 표시",
      "suggested_interface": {
        "locationSearchResults": "any[]",
        "showLocationResults": "boolean",
        "showLocationMapModal": "boolean",
        "mapRegion": "{ latitude: number; longitude: number; latitudeDelta: number; longitudeDelta: number }"
      }
    },
    {
      "name": "LoadingContext",
      "states": [
        "loading",
        "roomsLoading",
        "participantsLoading",
        "refreshing"
      ],
      "description": "비동기 작업 로딩 상태. API 호출, 데이터 새로고침 중 표시",
      "suggested_interface": {
        "loading": "boolean",
        "roomsLoading": "boolean",
        "participantsLoading": "boolean",
        "refreshing": "boolean"
      }
    }
  ],
